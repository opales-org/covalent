<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.opales</groupId>
	<artifactId>covalent-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<name>Covalent Parent</name>
	<description>A lightweight Java component model and container.</description>
	<url>https://github.com/opales-org/covalent</url>

	<licenses>
		<license>
			<name>Mozilla Public License 2.0</name>
			<url>https://www.mozilla.org/MPL/2.0/</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Covalent contributors</name>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/opales-org/covalent</url>
		<connection>scm:git:https://github.com/opales-org/covalent.git</connection>
		<developerConnection>scm:git:https://github.com/opales-org/covalent.git</developerConnection>
	</scm>

	<modules>
		<module>covalent-core</module>
		<module>covalent-hmi</module>
		<module>covalent-supervision</module>
		<module>covalent-tests</module>
		<module>covalent-examples</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<javafx.version>21.0.12</javafx.version>
		<junit.version>4.13.2</junit.version>
		<elk.version>0.9.1</elk.version>
		<!-- ELK accepts any Guava from 15.0 on: pinned so that every build resolves the same one. -->
		<guava.version>33.7.2-jre</guava.version>
		<jacoco.plugin.version>0.8.13</jacoco.plugin.version>
		<maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
		<maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
		<maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
		<maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>
		<javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.opales</groupId>
				<artifactId>covalent-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.opales</groupId>
				<artifactId>covalent-hmi</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.opales</groupId>
				<artifactId>covalent-supervision</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-controls</artifactId>
				<version>${javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-web</artifactId>
				<version>${javafx.version}</version>
			</dependency>
			<dependency>
				<groupId>junit</groupId>
				<artifactId>junit</artifactId>
				<version>${junit.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.elk</groupId>
				<artifactId>org.eclipse.elk.core</artifactId>
				<version>${elk.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.elk</groupId>
				<artifactId>org.eclipse.elk.alg.layered</artifactId>
				<version>${elk.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven.compiler.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven.surefire.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven.jar.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.openjfx</groupId>
					<artifactId>javafx-maven-plugin</artifactId>
					<version>${javafx.maven.plugin.version}</version>
				</plugin>
				<!-- Javadoc level lock: a module that declares this plugin fails its build (verify phase) on any
				     javadoc warning or error. A module can relax the doclint groups or exclude packages. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>${maven.javadoc.plugin.version}</version>
					<configuration>
						<doclint>all</doclint>
						<failOnError>true</failOnError>
						<failOnWarnings>true</failOnWarnings>
						<release>${maven.compiler.release}</release>
					</configuration>
					<executions>
						<execution>
							<id>javadoc-lock</id>
							<phase>verify</phase>
							<goals>
								<goal>javadoc-no-fork</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
